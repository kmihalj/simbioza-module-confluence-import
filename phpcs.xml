<?xml version="1.0"?>
<ruleset name="Simbioza Confluence Import">
    <description>PSR-12 and project quality rules.</description>
    <file>src</file>
    <file>tests</file>
    <file>views</file>
    <file>heartphrame-manifest.php</file>
    <file>config</file>
    <file>resources/migrations</file>
    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength.TooLong"/>
    </rule>
</ruleset>
